{
  "schemaVersion": 1,
  "updatedAt": "2026-08-29",
  "status": "historical-gen1-rendering-contract",
  "historicalScope": "M4-M10 bridge evidence; the current single-renderer contract is codestable/epics/001-x-view-layer-modernization/spec.md and compatibility-contract.md.",
  "defaultEnabled": false,
  "rules": [
    "React owns only an explicitly allowlisted capability boundary.",
    "A React render is not committed until its complete legacy fallback has been retained; after commit the fallback is detached from the live DOM and restored as the same node on unmount.",
    "Existing PHP builders, HTTP methods, query names, form names/ids and legacy plugin instances remain authoritative transport contracts.",
    "Arbitrary formatter, extension or third-party plugin DOM is moved into a React-owned legacy island without cloning so listeners and jQuery/plugin data survive.",
    "Unsupported or structurally unknown capabilities fail closed to the legacy page/component rather than attempting a lossy conversion."
  ],
  "capabilities": {
