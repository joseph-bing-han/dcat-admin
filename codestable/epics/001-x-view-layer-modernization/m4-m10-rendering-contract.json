      "reactOwns": ["keyboard navigation lifecycle and scoped modern state"],
      "legacyIslands": ["exact navigation/sidebar root remains in its original DOM position", "custom menu/plugin descendants"],
      "fallback": "page"
    },
    "layout.menu": {
      "milestone": "M4",
      "mode": "structured-react-payload",
