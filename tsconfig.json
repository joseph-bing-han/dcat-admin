{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@/*": ["./resources/modern/ui/*"]
        },
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["vitest/globals"]
    },
    "include": ["resources/modern/**/*.ts", "resources/modern/**/*.tsx", "vite.config.mts", "vitest.config.mts"]
}
