{
  "private": true,
  "scripts": {
    "modern:coverage:update": "node scripts/view-modernization-coverage.js",
    "modern:coverage": "node scripts/view-modernization-coverage.js --check",
    "modern:grid-capabilities:update": "node scripts/view-modernization-grid-capabilities.js",
    "modern:grid-capabilities": "node scripts/view-modernization-grid-capabilities.js --check",
    "modern:form-capabilities:update": "node scripts/view-modernization-form-capabilities.js",
    "modern:form-capabilities": "node scripts/view-modernization-form-capabilities.js --check",
    "modern:tokens:update": "node scripts/view-modernization-tokens.js",
    "modern:tokens": "node scripts/view-modernization-tokens.js --check",
    "modernization:baseline": "node scripts/view-modernization-baseline.js",
    "modern:php-static": "node scripts/view-modernization-php-static.js",
    "modern:bootstrap-absence": "node scripts/view-modernization-bootstrap-absence.js",
    "modern:typecheck": "tsc --noEmit",
    "modern:test": "vitest run",
    "modern:browser:self-test": "node scripts/view-modernization-browser.mjs --self-test",
    "modern:browser": "node scripts/view-modernization-browser.mjs",
    "demo:browser": "node scripts/dcat-admin-demo-browser.mjs",
    "modern:compat:build": "vite build --config vite.compat.config.mts && vite build --config vite.fallback.config.mts",
    "modern:build": "vite build && npm run modern:compat:build && node scripts/view-modernization-notices.js && node scripts/view-modernization-legacy-assets.js --out-dir=resources/dist",
    "modern:artifact": "node scripts/view-modernization-artifact.js",
    "modern:verify": "npm run modern:coverage && npm run modern:grid-capabilities && npm run modern:form-capabilities && npm run modern:tokens && npm run modernization:baseline && npm run modern:php-static && npm run modern:bootstrap-absence && npm run modern:typecheck && npm run modern:test && npm run modern:build && npm run modern:artifact && npm run modern:browser:self-test",
    "dev": "npm run development",
    "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "watch": "npm run development -- --watch",
    "watch-poll": "npm run watch -- --watch-poll",
    "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
    "prod": "npm run production",
    "production": "cross-env NODE_ENV=production node --openssl-legacy-provider node_modules/webpack/bin/webpack.js --no-progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "cross-env": "^5.2.1",
    "jsdom": "^30.0.1",
    "laravel-mix": "^4.1.4",
    "lodash": "^4.17.15",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-aria": "3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-stately": "3.49.0",
    "resolve-url-loader": "^2.3.1",
    "rtlcss": "^2.4.0",
    "sass": "^1.22.12",
    "sass-loader": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-template-compiler": "^2.6.12",
    "webpack-cli": "^3.3.5"
  },
  "dependencies": {
    "jquery": "^3.7.1"
  }
}
