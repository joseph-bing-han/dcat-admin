{
    "name": "joseph-bing-han/laravel-admin",
    "replace": {
        "dcat/laravel-admin": "2.2.2-beta"
    },
    "description": "Dcat Admin for Laravel 8-10 with a modern React renderer and Bootstrap-free Blade/PJAX compatibility islands.",
    "type": "library",
    "keywords": [
        "dcat",
        "laravel",
        "admin",
        "grid",
        "form",
        "react",
        "laravel admin"
    ],
    "homepage": "https://github.com/joseph-bing-han/dcat-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Joseph",
            "email": "joseph.bing.han@gmail.com"
        }
    ],
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "require": {
        "php": ">=8.0.0",
        "laravel/framework": "^8.0|^9.0|^10.0",
        "spatie/eloquent-sortable": "^4.0",
        "doctrine/dbal": "^3.0"
    },
    "require-dev": {
        "laravel/dusk": "^6.25.2",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Dcat\\Admin\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dcat\\Admin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcat\\Admin\\AdminServiceProvider"
            ]
        }
    }
}
